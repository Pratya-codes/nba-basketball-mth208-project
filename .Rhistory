cityDejaVu <- function() {
N <- 200000L
A <- 120L
B <- 40L
E <- 500L
days<-1
x<-sample(1:N,E,replace=TRUE)
while(!any(x<=(A+B))){
x<-sample(1:N,E,replace=TRUE)
days<-days+1
}
p_day<-((A+B)/N)*E
list(days = as.integer(days), p_day = as.numeric(p_day))
}
## Print p_day
print(cityDejaVu()$p_day)
set.seed(12345)
## run cityDejaVu 200 times to compute the mean of "days";
## save it in mean_days and print it
days_vec<-numeric(length=200)
for(i in 1:200)
{
days_vec[i] <- (cityDejaVu()$days)
}
mean_days<-mean(days_vec)
print(mean_days)
hsl_convert <- function(img) {
img.mat<-as.array(img[, ,1, ])
dims <- dim(col.mat)
x<-array(0,dims)
for(i in 1:dims[1]){
for(j in 1:dims[2]){
c_max<-max(img.mat[i,j,])
c_min<-min(img.mat[i,j,])
del<-c_max-c_min
L<-(c_max+c_min)/2
S<-0
if(del==0){
S<-0
}else{
if((2*L)>=1){
S<-del/(2-2*L)
}else{
S<-del/2*L
}
}
H<-0
if(del==0){
H<-0
}else{
if(c_max==img.mat[i,j,1]){
H<-((img.mat[i,j,2]-img.mat[i,j,3])/del)%%6
}else if(c_max==img.mat[i,j,2]){
H<-(((img.mat[i,j,3]-img.mat[i,j,1])/del)+2)
}else if(c_max==img.mat[i,j,3]){
H<-(((img.mat[i,j,1]-img.mat[i,j,2])/del)+4)
}
}
H<-H%%360
}
}
}
