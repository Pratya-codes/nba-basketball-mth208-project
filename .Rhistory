# Load the necessary libraries for data manipulation and plotting
library(ggplot2)
library(dplyr)
library(readr)
# Load the Titanic dataset from the provided URL
titanic_df <- read_csv("https://dvats.github.io/assets/data/titanic.csv")
# Prepare the data:
# Convert the 'Survived' column from a number (0/1) to a factor.
# We set the levels and labels to ensure "Died" appears at the bottom and "Survived" at the top.
titanic_df <- titanic_df %>%
mutate(
Survived = factor(Survived,
levels = c(0, 1),
labels = c("Died", "Survived"))
)
# Create the final plot object, named finalP
finalP <- ggplot(titanic_df, aes(x = Fare, y = Survived, fill = Sex)) +
# Add jittered points in the background to show the distribution of all passengers.
# We use position_jitterdodge to separate the points for males and females, just like the boxplots.
geom_point(
aes(color = Sex), # Map point color to Sex
position = position_jitterdodge(
dodge.width = 0.9,
jitter.height = 0.25,
jitter.width = 0
),
alpha = 0.4,
size = 1.5
) +
# Add the boxplots on top of the points.
# position_dodge separates the boxplots for males and females.
geom_boxplot(
position = position_dodge(width = 0.9),
width = 0.7,
alpha = 0.6,
outlier.shape = NA # Hide the default outliers since we are plotting all points with geom_point
) +
# Manually set the colors to match the plot image (classic ggplot2 defaults).
scale_color_manual(values = c("female" = "#F8766D", "male" = "#00BFC4")) +
scale_fill_manual(values = c("female" = "#F8766D", "male" = "#00BFC4")) +
# Apply all titles and axis labels.
labs(
title = "Fare vs Survival",
subtitle = "Irrespective of Sex, richer people survived",
x = "Fare",
y = NULL # This removes the y-axis title.
) +
# Use a minimal theme and remove the horizontal grid lines to match the example.
theme_minimal() +
theme(
panel.grid.major.y = element_blank(),
panel.grid.minor.y = element_blank()
)
# Display the plot. This must be the last line of your code.
finalP
