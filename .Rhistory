# Load required libraries
library(rvest)
library(dplyr)
library(readr)
# Target URL
url <- "https://www.watchoutinvestors.com/wilful_defaulters_bank_wise.asp"
# Read the webpage
page <- read_html(url)
# Extract the first table on the page
data <- page %>%
html_element("table") %>%
html_table(fill = TRUE)
# Clean column names
colnames(data) <- c("Bank_Name", "Outstanding_Amount_Cr")
# Remove possible NA rows or blank headers
data <- data %>%
filter(!is.na(Bank_Name) & Bank_Name != "Bank Name")
# Clean amount column: remove commas and convert to numeric
data <- data %>%
mutate(
Outstanding_Amount_Cr = as.numeric(gsub(",", "", Outstanding_Amount_Cr))
)
# Save to CSV
write_csv(data, "wilful_defaulters_2018.csv")
# Preview first few rows
print(head(data))
# Preview first few rows
print(data)
print(n=84,data)
print(n=85,data)
library(rvest)
library(dplyr)
library(readr)
library(glue)
# Function to scrape one quarter
scrape_quarter <- function(date_label) {
base_url <- "https://www.watchoutinvestors.com/wilful_defaulters_bank_wise.asp"
url <- glue("{base_url}?order_date={date_label}")
message("Scraping data for: ", date_label)
# Try scraping
page <- tryCatch(read_html(url), error = function(e) return(NULL))
if (is.null(page)) {
message("Failed to read page for: ", date_label)
return(NULL)
}
# Extract table
tbl <- page %>%
html_element("table") %>%
html_table(fill = TRUE)
if (is.null(tbl) || nrow(tbl) < 2) {
message("No valid table for: ", date_label)
return(NULL)
}
# Clean and format
colnames(tbl) <- c("Bank_Name", "Outstanding_Amount_Cr")
tbl <- tbl %>%
filter(!is.na(Bank_Name) & Bank_Name != "Bank Name") %>%
mutate(
Outstanding_Amount_Cr = as.numeric(gsub(",", "", Outstanding_Amount_Cr)),
Quarter = date_label
)
# Save to CSV
file_name <- paste0("wilful_defaulters_", gsub(" ", "_", date_label), ".csv")
write_csv(tbl, file_name)
message("Saved: ", file_name)
return(tbl)
}
# Generate quarter-end dates (from Mar 2018 to Jun 2024)
quarters <- c(
"31 March 2018", "30 June 2018", "30 September 2018", "31 December 2018",
"31 March 2019", "30 June 2019", "30 September 2019", "31 December 2019",
"31 March 2020", "30 June 2020", "30 September 2020", "31 December 2020",
"31 March 2021", "30 June 2021", "30 September 2021", "31 December 2021",
"31 March 2022", "30 June 2022", "30 September 2022", "31 December 2022",
"31 March 2023", "30 June 2023", "30 September 2023", "31 December 2023",
"31 March 2024", "30 June 2024"
)
# Run scraper for all quarters
all_data <- lapply(quarters, scrape_quarter)
# Combine into one big dataset (optional)
combined <- bind_rows(all_data)
write_csv(combined, "wilful_defaulters_all_quarters.csv")
message("✅ All quarters scraped and combined successfully!")
